        <mxCell id="n271" value="Account-wide Lambda starvation, an unbounded bill, and silently dropped writes. Cost is bounded only by the attacker&amp;#8217;s patience." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
