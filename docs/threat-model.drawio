        <mxCell id="n283" value="&lt;b&gt;AS-6&lt;/b&gt;&lt;br&gt;Cross-origin&lt;br&gt;browser abuse&lt;br&gt;&lt;font color=&quot;#777777&quot;&gt;High&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;fontColor=#1A1A1A;" vertex="1" parent="1">
