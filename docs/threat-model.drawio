        <mxCell id="n101" value="Click-Log Ingestion Pipeline — Data Flow &amp;amp; Trust Boundaries" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1500" height="32" as="geometry" />
        </mxCell>
        <mxCell id="n102" value="aws-ingesting-click-logs-using-terraform @ 88fb8b6 &amp;#183; STRIDE threat model v1.0 &amp;#183; red dashed = trust boundary &amp;#183; red notes = Critical, orange = High" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1500" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n103" value="TB-1 &amp;#183; INTERNET — UNTRUSTED" style="rounded=0;html=1;dashed=1;dashPattern=6 6;strokeWidth=2;strokeColor=#CC0000;fillColor=#FFF5F5;opacity=60;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#CC0000;" vertex="1" parent="1">
