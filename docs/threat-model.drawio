        <mxCell id="n104" value="Web application&lt;br&gt;(ORDERAPP / BILLAPP)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;strokeColor=#1F6FBF;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="110" y="230" width="60" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n105" value="Anonymous attacker" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;fontStyle=1;strokeColor=#CC0000;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="110" y="420" width="60" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n106" value="&lt;b&gt;S-2 (Critical)&lt;/b&gt; &amp;#8212; the shared token is published verbatim in README.md, so &amp;#8220;attacker&amp;#8221; and &amp;#8220;web app&amp;#8221; are the same trust level in practice.&lt;br&gt;&lt;br&gt;&lt;b&gt;S-3 (High)&lt;/b&gt; token is embeddable in browser JS." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=7;spacingRight=6;spacingTop=4;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="55" y="540" width="220" height="115" as="geometry" />
        </mxCell>
        <mxCell id="n107" value="AWS Cloud &amp;#183; us-east-1 (single account)" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=34;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="120" width="1310" height="790" as="geometry" />
        </mxCell>
        <mxCell id="n108" value="TB-2 / TB-3 &amp;#183; API GATEWAY EDGE" style="rounded=0;html=1;dashed=1;dashPattern=8 8;strokeWidth=2;strokeColor=#CC0000;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#CC0000;" vertex="1" parent="1">
          <mxGeometry x="370" y="170" width="330" height="500" as="geometry" />
        </mxCell>
        <mxCell id="n109" value="Amazon API Gateway&lt;br&gt;POST /dev/clicklogger" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;gradientColor=#FF4F8B;fillColor=#E7157B;" vertex="1" parent="1">
          <mxGeometry x="430" y="210" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n110" value="&lt;b&gt;I-2 (High)&lt;/b&gt; data_trace_enabled = true &amp;#8594; full bodies + headers to logs&lt;br&gt;&lt;b&gt;I-7 (High)&lt;/b&gt; ACAO &amp;#8216;*&amp;#8217; / Allow-Methods &amp;#8216;*&amp;#8217;&lt;br&gt;&lt;b&gt;D-4 (High)&lt;/b&gt; no WAF, API key or usage plan &amp;#8212; one global 100/50 throttle&lt;br&gt;&lt;b&gt;R-3 (Med)&lt;/b&gt; no access logging &amp;#183; &lt;b&gt;D-8 (Med)&lt;/b&gt; region-global account setting" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=7;spacingRight=6;spacingTop=4;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="378" y="328" width="314" height="92" as="geometry" />
        </mxCell>
        <mxCell id="n111" value="Lambda Authorizer&lt;br&gt;APIGatewayAuthorizerHandler" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;gradientColor=#F78E04;fillColor=#D05C17;" vertex="1" parent="1">
          <mxGeometry x="430" y="448" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n112" value="&lt;b&gt;E-1 (Critical)&lt;/b&gt; returns getAllowAllPolicy() &amp;#8594; ALL methods on ALL resources of the stage&lt;br&gt;&lt;b&gt;I-1 (Critical)&lt;/b&gt; prints the Authorization token to CloudWatch&lt;br&gt;&lt;b&gt;S-1 (Critical)&lt;/b&gt; static token in a plaintext env var, no expiry or rotation&lt;br&gt;&lt;b&gt;S-5 (Med)&lt;/b&gt; principalId hard-coded &amp;#8220;xxxx&amp;#8221; &amp;#183; &lt;b&gt;E-2 (Med)&lt;/b&gt; 300s default cache&lt;br&gt;&lt;b&gt;D-5 (Med)&lt;/b&gt; NPE if AUTH_TOKENS unset &amp;#183; &lt;b&gt;E-10 (Low)&lt;/b&gt; non-constant-time compare" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=7;spacingRight=6;spacingTop=4;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="378" y="566" width="314" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n113" value="TB-5 &amp;#183; LAMBDA COMPUTE (one shared IAM role)" style="rounded=0;html=1;dashed=1;dashPattern=8 8;strokeWidth=2;strokeColor=#CC0000;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#CC0000;" vertex="1" parent="1">
          <mxGeometry x="740" y="170" width="330" height="500" as="geometry" />
        </mxCell>
        <mxCell id="n114" value="clicklogger-lambda&lt;br&gt;ClickLoggerHandler" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;gradientColor=#F78E04;fillColor=#D05C17;" vertex="1" parent="1">
          <mxGeometry x="800" y="210" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n115" value="&lt;b&gt;I-10 (High)&lt;/b&gt; always answers 200 OK &amp;#8212; Firehose failures invisible to the caller&lt;br&gt;&lt;b&gt;S-4 (High)&lt;/b&gt; trusts client-supplied callerid / user / clientip&lt;br&gt;&lt;b&gt;D-2 (High)&lt;/b&gt; 2048 MB / 300 s per invocation &amp;#183; &lt;b&gt;T-6 (Med)&lt;/b&gt; log injection" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=7;spacingRight=6;spacingTop=4;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="748" y="328" width="314" height="92" as="geometry" />
        </mxCell>
        <mxCell id="n116" value="clicklogger-lambda-&lt;br&gt;stream-consumer" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;gradientColor=#F78E04;fillColor=#D05C17;" vertex="1" parent="1">
          <mxGeometry x="800" y="448" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n117" value="&lt;b&gt;T-4 (High)&lt;/b&gt; marks every record Result.Ok even when validation failed&lt;br&gt;&lt;b&gt;T-5 (High)&lt;/b&gt; swallows JsonSyntaxException and drops the recordId &amp;#8594; batch loss&lt;br&gt;&lt;b&gt;T-1 (High)&lt;/b&gt; PutItem with no ConditionExpression &amp;#8594; silent overwrite&lt;br&gt;&lt;b&gt;E-3 (High)&lt;/b&gt; shares its role with the authorizer &amp;#183; &lt;b&gt;R-5 (Med)&lt;/b&gt; mm/dd format bug" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=7;spacingRight=6;spacingTop=4;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="748" y="566" width="314" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n118" value="&lt;b&gt;Shared across all three functions &amp;#8212; E-3 / E-4 / E-7 / E-8 (High):&lt;/b&gt; one IAM role for authorizer + ingest + transform; firehose:* and dynamodb:Scan/ListTables granted but unused; runtime = java8 (EOL); AWS SDK v1 1.11.774 and junit at compile scope." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=7;spacingRight=6;spacingTop=4;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="740" y="676" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n119" value="Kinesis Data Firehose&lt;br&gt;JSON &amp;#8594; Parquet" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.kinesis_data_firehose;gradientColor=#945DF2;fillColor=#5A30B5;" vertex="1" parent="1">
          <mxGeometry x="1140" y="210" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n120" value="&lt;b&gt;T-3 (Critical)&lt;/b&gt;&lt;br&gt;delivery role holds s3:*, glue:*, lambda:*, logs:* on Resource &amp;#8220;*&amp;#8221;&lt;br&gt;&lt;b&gt;T-8 (Med)&lt;/b&gt; processor pinned to :$LATEST&lt;br&gt;&lt;b&gt;I-5 (Med)&lt;/b&gt; no KMS key, UNCOMPRESSED" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=7;spacingRight=6;spacingTop=4;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="1082" y="328" width="196" height="108" as="geometry" />
        </mxCell>
        <mxCell id="n121" value="TB-6 &amp;#183; DATA AT REST" style="rounded=0;html=1;dashed=1;dashPattern=8 8;strokeWidth=2;strokeColor=#CC0000;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#CC0000;" vertex="1" parent="1">
          <mxGeometry x="1320" y="170" width="290" height="660" as="geometry" />
        </mxCell>
        <mxCell id="n122" value="AWS Glue Data Catalog&lt;br&gt;clickloggerdatabase" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.glue;gradientColor=#945DF2;fillColor=#5A30B5;" vertex="1" parent="1">
          <mxGeometry x="1426" y="206" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n123" value="&lt;b&gt;T-9 (Med)&lt;/b&gt; location is an S3 &lt;i&gt;ARN&lt;/i&gt;, not s3:// URI&lt;br&gt;&lt;b&gt;T-10 (Low)&lt;/b&gt; JsonSerDe declared, Parquet written" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=7;spacingRight=6;spacingTop=4;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="1334" y="322" width="262" height="54" as="geometry" />
        </mxCell>
        <mxCell id="n124" value="Amazon S3&lt;br&gt;firehose delivery bucket" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;gradientColor=#60A337;fillColor=#277116;" vertex="1" parent="1">
          <mxGeometry x="1426" y="400" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n125" value="&lt;b&gt;I-3 (High)&lt;/b&gt; no encryption config, no public-access block, no TLS-only policy, no versioning or access logging&lt;br&gt;&lt;b&gt;I-8 (High)&lt;/b&gt; no lifecycle rule &amp;#8212; PII kept forever" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=7;spacingRight=6;spacingTop=4;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="1334" y="516" width="262" height="74" as="geometry" />
        </mxCell>
        <mxCell id="n126" value="Amazon DynamoDB&lt;br&gt;clickloggertable" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;gradientColor=#4D72F3;fillColor=#3334B9;" vertex="1" parent="1">
          <mxGeometry x="1426" y="618" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n127" value="&lt;b&gt;I-4 (High)&lt;/b&gt; no CMK, no PITR, no deletion protection&lt;br&gt;&lt;b&gt;T-1 (High)&lt;/b&gt; overwritable by key &amp;#183; &lt;b&gt;D-3 (High)&lt;/b&gt; fixed 5 RCU / 5 WCU, no autoscaling, no DLQ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=7;spacingRight=6;spacingTop=4;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="1334" y="734" width="262" height="76" as="geometry" />
        </mxCell>
        <mxCell id="n128" value="Amazon CloudWatch Logs" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientDirection=north;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;gradientColor=#F54749;fillColor=#C7131F;" vertex="1" parent="1">
          <mxGeometry x="600" y="760" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n129" value="&lt;b&gt;I-1 + E-6 (Critical chain)&lt;/b&gt; the authorizer writes the token here in cleartext, while the API Gateway role holds logs:GetLogEvents / FilterLogEvents on Resource &amp;#8220;*&amp;#8221; &amp;#8212; a log read yields the credential. &lt;b&gt;R-2 (Med)&lt;/b&gt; retention is only 3&amp;#8211;7 days." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=7;spacingRight=6;spacingTop=4;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="330" y="852" width="560" height="54" as="geometry" />
        </mxCell>
        <mxCell id="e130" value="① HTTPS POST + Authorization header" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#232F3E;fontSize=10;fontStyle=1;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="n104" target="n109">
          <mxGeometry relative="1" as="geometry" />
