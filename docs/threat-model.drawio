        <mxCell id="n144" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;#9644; red dashed box &amp;#8212; trust boundary&lt;br&gt;&amp;#8594; solid arrow &amp;#8212; data flow (numbered)&lt;br&gt;&amp;#8594; red dashed &amp;#8212; attacker-reachable path&lt;br&gt;&amp;#8594; grey dashed &amp;#8212; log write&lt;br&gt;&lt;br&gt;&lt;b&gt;Finding note colours&lt;/b&gt;&lt;br&gt;&amp;#9632; Critical &amp;#160;&amp;#9632; High &amp;#160;&amp;#9632; Medium &amp;#160;&amp;#9632; Low&lt;br&gt;&lt;br&gt;Not shown: &lt;b&gt;I-6 (Critical)&lt;/b&gt; AUTH_TOKENS and whole-resource outputs land in plaintext Terraform state; &lt;b&gt;E-11 (High)&lt;/b&gt; apply runs on developer credentials with no policy-as-code gate." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;fontSize=10;" vertex="1" parent="1">
