        <mxCell id="n277" value="Read, write and delete objects in every bucket in the account" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontColor=#1A1A1A;" vertex="1" parent="1">
