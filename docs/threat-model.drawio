        <mxCell id="n281" value="The blast radius of a click-log pipeline becomes the entire account&amp;#8217;s data estate." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
